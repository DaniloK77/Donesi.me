generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  RESTAURANT_OWNER
  COURIER
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String
  name          String
  phone         String?
  role          UserRole      @default(CUSTOMER)
  emailVerified Boolean       @default(false)
  addresses     Address[]
  sessions      UserSession[]
  cart          Cart?
  orders        Order[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  street    String
  city      String   @default("Podgorica")
  latitude  Float?
  longitude Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isDefault])
}

enum DealCategory {
  VEGAN
  SUSHI
  PIZZA_FASTFOOD
  OTHER
}

model Deal {
  id                 String       @id @default(cuid())
  name               String
  label              String?
  imageUrl           String
  discountPercentage Int
  category           DealCategory
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([category])
}

model Category {
  id              String   @id @default(cuid())
  name            String
  imageUrl        String
  restaurantCount Int
  slug            String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PodgoricaStreet {
  id        String @id @default(cuid())
  name      String @unique
  latitude  Float
  longitude Float
}

model Restaurant {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  logoUrl         String
  coverImageUrl   String?
  category        String
  rating          Float          @default(0)
  address         String
  city            String         @default("Podgorica")
  latitude        Float
  longitude       Float
  deliveryTimeMin Int            @default(30)
  displayOrder    Int
  menuCategories  MenuCategory[]
  reviews         Review[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([displayOrder])
  @@index([city, category])
}

model Review {
  id             String     @id @default(cuid())
  authorName     String
  authorLocation String?
  authorImageUrl String?
  rating         Int
  comment        String
  restaurantId   String
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt      DateTime   @default(now())

  @@index([restaurantId, createdAt])
}

model MenuCategory {
  id           String     @id @default(cuid())
  name         String
  displayOrder Int
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items        MenuItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([restaurantId, name])
  @@index([restaurantId, displayOrder])
}

model MenuItem {
  id                    String       @id @default(cuid())
  name                  String
  description           String?
  price                 Decimal      @db.Decimal(10, 2)
  imageUrl              String?
  isAvailable           Boolean      @default(true)
  isFeatured            Boolean      @default(false)
  weeklyDiscountPercent Int?
  discountWeekStart     DateTime?
  displayOrder          Int
  menuCategoryId        String
  menuCategory          MenuCategory @relation(fields: [menuCategoryId], references: [id], onDelete: Cascade)
  cartItems             CartItem[]
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@unique([menuCategoryId, name])
  @@index([menuCategoryId, displayOrder])
  @@index([weeklyDiscountPercent])
}

model Cart {
  id        String     @id @default(cuid())
  items     CartItem[]
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id            String   @id @default(cuid())
  quantity      Int      @default(1)
  unitPrice     Decimal  @db.Decimal(10, 2)
  customization Json?
  cartId        String
  cart          Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  menuItemId    String
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([cartId, menuItemId])
  @@index([cartId, createdAt])
  @@index([menuItemId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum DeliveryType {
  DELIVERY
  PICKUP
}

enum CourierVehicle {
  SCOOTER
  BICYCLE
  CAR
}

/// Cash on delivery is the only method the platform supports today. It is
/// modelled as an enum so adding card payments later is an additive change.
enum PaymentMethod {
  CASH_ON_DELIVERY
}

enum CancelledBy {
  CUSTOMER
  ADMIN
  RESTAURANT
}

model Courier {
  id        String         @id @default(cuid())
  name      String
  phone     String
  vehicle   CourierVehicle @default(SCOOTER)
  rating    Float          @default(5)
  isActive  Boolean        @default(true)
  orders    Order[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([isActive])
}

model Order {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  courierId        String?
  courier          Courier?      @relation(fields: [courierId], references: [id], onDelete: SetNull)
  status           OrderStatus   @default(PENDING)
  deliveryType     DeliveryType  @default(DELIVERY)
  addressLabel     String?
  addressStreet    String?
  addressCity      String?
  addressLatitude  Float?
  addressLongitude Float?
  subtotal         Decimal       @db.Decimal(10, 2)
  paymentMethod    PaymentMethod @default(CASH_ON_DELIVERY)
  items            OrderItem[]

  /// Set when the order is accepted; the estimate is generated at that moment.
  confirmedAt              DateTime?
  /// Promised delivery window in minutes, as shown to the customer.
  estimatedDeliveryMinutes Int?
  /// Absolute instant the estimate points at, so the client can count down.
  estimatedDeliveryAt      DateTime?

  cancelledAt        DateTime?
  cancelledBy        CancelledBy?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([courierId])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId     String
  name           String
  quantity       Int
  unitPrice      Decimal  @db.Decimal(10, 2)
  customization  Json?
  restaurantId   String
  restaurantName String
  createdAt      DateTime @default(now())

  @@index([orderId])
}
