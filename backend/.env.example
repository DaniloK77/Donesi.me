# Port the Express API listens on. Defaults to 5001 in src/config/env.js.
# Keep this different from the Next.js dev server (3000).
PORT=5001

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Origin allowed by CORS. Must match where the frontend runs,
# and must be exact — credentialed requests forbid a wildcard.
FRONTEND_URL="http://localhost:3000"

# "production" makes the session cookie Secure-only.
NODE_ENV="development"

# Session lifetime, and how close to expiry POST /api/auth/refresh rotates it.
SESSION_DURATION_DAYS=7
SESSION_REFRESH_THRESHOLD_HOURS=24
