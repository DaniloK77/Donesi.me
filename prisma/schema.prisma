generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum DealCategory {
  VEGAN
  SUSHI
  PIZZA_FASTFOOD
  OTHER
}

model Deal {
  id                 String       @id @default(cuid())
  name               String
  label              String?
  imageUrl           String
  discountPercentage Int
  category           DealCategory
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([category])
}

model Category {
  id              String   @id @default(cuid())
  name            String
  imageUrl        String
  restaurantCount Int
  slug            String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PodgoricaStreet {
  id        String @id @default(cuid())
  name      String @unique
  latitude  Float
  longitude Float
}

model Restaurant {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  logoUrl         String
  coverImageUrl   String?
  category        String
  rating          Float          @default(0)
  address         String
  city            String         @default("Podgorica")
  latitude        Float
  longitude       Float
  deliveryTimeMin Int            @default(30)
  displayOrder    Int
  menuCategories  MenuCategory[]
  reviews         Review[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([displayOrder])
  @@index([city, category])
}

model Review {
  id             String     @id @default(cuid())
  authorName     String
  authorLocation String?
  authorImageUrl String?
  rating         Int
  comment        String
  restaurantId   String
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt      DateTime   @default(now())

  @@index([restaurantId, createdAt])
}

model MenuCategory {
  id           String     @id @default(cuid())
  name         String
  displayOrder Int
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items        MenuItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([restaurantId, name])
  @@index([restaurantId, displayOrder])
}

model MenuItem {
  id                    String       @id @default(cuid())
  name                  String
  description           String?
  price                 Decimal      @db.Decimal(10, 2)
  imageUrl              String?
  isAvailable           Boolean      @default(true)
  isFeatured            Boolean      @default(false)
  weeklyDiscountPercent Int?
  discountWeekStart     DateTime?
  displayOrder          Int
  menuCategoryId        String
  menuCategory          MenuCategory @relation(fields: [menuCategoryId], references: [id], onDelete: Cascade)
  cartItems             CartItem[]
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@unique([menuCategoryId, name])
  @@index([menuCategoryId, displayOrder])
  @@index([weeklyDiscountPercent])
}

model Cart {
  id        String     @id @default(cuid())
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id         String   @id @default(cuid())
  quantity   Int      @default(1)
  unitPrice  Decimal  @db.Decimal(10, 2)
  cartId     String
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([cartId, menuItemId])
  @@index([cartId, createdAt])
  @@index([menuItemId])
}
